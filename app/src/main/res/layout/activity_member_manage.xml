<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="ফিরে যান"
            android:padding="12dp"
            app:srcCompat="@drawable/ic_lucide_logout"
            app:tint="@color/text_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="সদস্যের ভূমিকা ও অনুমোদন"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="সদস্যের দায়িত্ব ও মেসে সক্রিয় থাকার অবস্থা পরিবর্তন করুন"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <!-- Member Summary Header Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                style="@style/SmartCardView">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">

                            <ImageView
                                android:id="@+id/ivMemberAvatar"
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:src="@drawable/ic_member"
                                android:contentDescription="প্রোফাইল ছবি" />

                            <androidx.appcompat.widget.AppCompatImageButton
                                android:id="@+id/btnChangeMemberPhoto"
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_gravity="bottom|end"
                                android:background="@drawable/badge_credit"
                                android:backgroundTint="@color/primary"
                                android:contentDescription="ছবি পরিবর্তন"
                                android:padding="5dp"
                                app:srcCompat="@drawable/ic_camera"
                                app:tint="@android:color/white" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvMemberName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="সদস্যের নাম"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvMemberPhone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+880 1700 000000"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tvCurrentRoleBadge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_payer_badge"
                                    android:paddingHorizontal="6dp"
                                    android:paddingVertical="2dp"
                                    android:text="সদস্য"
                                    android:textColor="@color/primary"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvCurrentStatusBadge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:background="@drawable/badge_credit"
                                    android:paddingHorizontal="6dp"
                                    android:paddingVertical="2dp"
                                    android:text="সক্রিয়"
                                    android:textColor="@color/credit_green"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Editable Fields for Name and Phone -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/border_stroke" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="সদস্যের তথ্য সম্পাদনা"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="নাম">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etMemberName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="ফোন নম্বর">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etMemberPhone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="phone"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Role Selector Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                style="@style/SmartCardView">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ভূমিকা নির্ধারণ (কেবল ম্যানেজার)"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="মিল ও বাজার এন্ট্রি করার অনুমতি নিয়ন্ত্রণ করে"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <RadioGroup
                        android:id="@+id/rgRoleSelector"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <RadioButton
                            android:id="@+id/rbRoleMember"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="সাধারণ সদস্য (হিসাব ও মিল দেখতে পারবেন)"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rbRoleAssistant"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="সহকারী ম্যানেজার / বাজার বয় (বাজার ও খরচ এন্ট্রি করতে পারবেন)"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rbRoleManager"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="মেস ম্যানেজার (সম্পূর্ণ পরিচালনা ও নিয়ন্ত্রণ ক্ষমতা)"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Status Controls Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                style="@style/SmartCardView">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="মেসের অবস্থা ও মিল স্ট্যাটাস"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="সদস্যের দৈনিক মিল চালু থাকবে কি না তা নিয়ন্ত্রণ করে"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <RadioGroup
                        android:id="@+id/rgStatusSelector"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <RadioButton
                            android:id="@+id/rbStatusActive"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="সক্রিয় (নিয়মিত খান, মিল গণনা চালু থাকবে)"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rbStatusOnLeave"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="ছুটিতে আছেন (মিল স্বয়ংক্রিয়ভাবে বন্ধ থাকবে)"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rbStatusLeft"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="মেস ছেড়েছেন (সংরক্ষিত, পূর্বের হিসাব অপরিবর্তিত থাকবে)"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Save Changes Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSavePermissions"
                style="@style/SmartButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="পরিবর্তন সংরক্ষণ করুন"
                android:textAllCaps="false"
                android:textSize="14sp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
