<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="2dp"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Expenses &amp; Bazar"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddExpense"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Log Cost"
            android:textSize="12sp"
            style="@style/Widget.MaterialComponents.Button" />
    </LinearLayout>

    <!-- Pro History Gate Banner -->
    <TextView
        android:id="@+id/tvHistoryGateBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2E1065"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="★ 30-Day Limit Active (Free) • Tap to unlock Lifetime Ledger"
        android:textColor="#C084FC"
        android:textSize="12sp"
        android:textStyle="bold"
        android:gravity="center_vertical"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvExpenses"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="12dp" />

</LinearLayout>
