<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="84dp"
    android:layout_height="84dp"
    android:layout_marginEnd="8dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_gravity="bottom|start"
        app:cardCornerRadius="8dp"
        app:cardElevation="1dp"
        app:strokeColor="@color/border_stroke"
        app:strokeWidth="1dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/ivReceiptThumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/tvReceiptSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="#99000000"
                android:gravity="center"
                android:paddingVertical="2dp"
                android:text="WebP"
                android:textColor="@android:color/white"
                android:textSize="9sp" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Delete receipt badge button -->
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnRemoveReceipt"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="top|end"
        android:background="@drawable/badge_due"
        android:contentDescription="Remove Receipt"
        android:padding="6dp"
        app:srcCompat="@drawable/ic_lucide_x" />

</FrameLayout>
