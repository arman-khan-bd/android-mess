<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeColor="#F1F5F9"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Member Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivAvatar"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_circle_avatar"
                android:backgroundTint="#FEE2E2"
                android:padding="8dp"
                android:src="@drawable/ic_lucide_user"
                app:tint="@color/coral_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvMemberName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="মেম্বার নাম"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvVacationBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/bg_pill_selected"
                    android:backgroundTint="#FEE2E2"
                    android:paddingStart="6dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="1dp"
                    android:text="ছুটিতে আছেন (মিল বন্ধ)"
                    android:textColor="@color/coral_primary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTotalCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="মোট: 0"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Meals Steppers Row: সকাল, দুপুর, রাত -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Breakfast -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="সকাল"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnMinusBreakfast"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_stepper_circle"
                        android:padding="6dp"
                        android:src="@drawable/ic_lucide_minus"
                        app:tint="@color/stepper_btn_tint" />

                    <TextView
                        android:id="@+id/tvBreakfast"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="34dp"
                        android:gravity="center"
                        android:text="0.0"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnPlusBreakfast"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_stepper_circle"
                        android:padding="6dp"
                        android:src="@drawable/ic_lucide_plus"
                        app:tint="@color/stepper_btn_tint" />
                </LinearLayout>

            </LinearLayout>

            <!-- Lunch -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="দুপুর"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnMinusLunch"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_stepper_circle"
                        android:padding="6dp"
                        android:src="@drawable/ic_lucide_minus"
                        app:tint="@color/stepper_btn_tint" />

                    <TextView
                        android:id="@+id/tvLunch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="34dp"
                        android:gravity="center"
                        android:text="0.0"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnPlusLunch"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_stepper_circle"
                        android:padding="6dp"
                        android:src="@drawable/ic_lucide_plus"
                        app:tint="@color/stepper_btn_tint" />
                </LinearLayout>

            </LinearLayout>

            <!-- Dinner -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="রাত"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnMinusDinner"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_stepper_circle"
                        android:padding="6dp"
                        android:src="@drawable/ic_lucide_minus"
                        app:tint="@color/stepper_btn_tint" />

                    <TextView
                        android:id="@+id/tvDinner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="34dp"
                        android:gravity="center"
                        android:text="0.0"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnPlusDinner"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_stepper_circle"
                        android:padding="6dp"
                        android:src="@drawable/ic_lucide_plus"
                        app:tint="@color/stepper_btn_tint" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Divider & Guest Meal Row -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:background="#F1F5F9" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="অতিথি মিল (গেস্ট)"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnMinusGuest"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_stepper_circle"
                    android:padding="5dp"
                    android:src="@drawable/ic_lucide_minus"
                    app:tint="@color/stepper_btn_tint" />

                <TextView
                    android:id="@+id/tvGuest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="34dp"
                    android:gravity="center"
                    android:text="0.0"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnPlusGuest"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_stepper_circle"
                    android:padding="5dp"
                    android:src="@drawable/ic_lucide_plus"
                    app:tint="@color/stepper_btn_tint" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
