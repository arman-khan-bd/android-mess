<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:openDrawer="end">

    <!-- MAIN APP SCREEN CONTAINER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- TOP HEADER MATCHING MOCKUP: ≡ | User Name & Role | Chat | Avatar -->
        <LinearLayout
            android:id="@+id/topStatusBar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@color/surface"
            android:elevation="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <!-- Hamburger Menu Button ≡ -->
            <FrameLayout
                android:id="@+id/btnMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_lucide_menu"
                    app:tint="@color/text_primary" />
            </FrameLayout>

            <!-- User Name and Role -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTopUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="মেস মেম্বার"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTopUserRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Manager"
                    android:textColor="@color/coral_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Notification Chat Bubble Button with Badge (Dark slate button + white chat icon) -->
            <FrameLayout
                android:id="@+id/btnNotificationCenter"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_stepper_circle"
                android:backgroundTint="#0F172A"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_chat_bubble"
                    app:tint="@android:color/white" />

                <TextView
                    android:id="@+id/tvNotificationBadge"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/badge_due"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@android:color/white"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Profile Avatar Button (Cartoon avatar matching mockup) -->
            <FrameLayout
                android:id="@+id/btnOpenProfileDrawer"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_circle_avatar"
                android:backgroundTint="#FEE2E2"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivAvatarMockup"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_avatar_cartoon" />

                <TextView
                    android:id="@+id/tvAvatarInitials"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="মে"
                    android:textColor="@color/coral_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Backwards-compatibility stubs retained with GONE visibility -->
            <TextView android:id="@+id/tvTopMessName" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/tvTopPlanPill" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/chipBalanceBadge" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <LinearLayout android:id="@+id/layoutMealToggle" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone">
                <TextView android:id="@+id/tvMealToggleLabel" android:layout_width="0dp" android:layout_height="0dp" />
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchQuickDinner" android:layout_width="0dp" android:layout_height="0dp" />
            </LinearLayout>
            <ImageButton android:id="@+id/btnCloudSync" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

        </LinearLayout>

        <!-- FRAGMENT HOSTING VIEW (High Density Screen Utilization) -->
        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 5-TAB COMPACT BOTTOM NAVIGATION BAR MATCHING MOCKUP (UNLABELED WITH ACTIVE CORAL ACCENT) -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/surface"
            app:elevation="8dp"
            app:itemIconTint="@color/selector_nav_tint"
            app:itemTextColor="@color/selector_nav_tint"
            app:itemIconSize="24dp"
            app:labelVisibilityMode="unlabeled"
            app:menu="@menu/menu_bottom_nav" />

    </LinearLayout>

    <!-- RIGHT-SIDE SLIDE-OVER PROFILE DRAWER -->
    <include
        layout="@layout/layout_drawer_right_hub"
        android:layout_width="310dp"
        android:layout_height="match_parent"
        android:layout_gravity="end" />

</androidx.drawerlayout.widget.DrawerLayout>
