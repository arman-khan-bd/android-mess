<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:openDrawer="end">

    <!-- MAIN APP SCREEN CONTAINER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- TOP HEADER: Hamburger | Name/Role | Meal Toggle | Sync Button | Notification Bell | Avatar -->
        <LinearLayout
            android:id="@+id/topStatusBar"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:background="@color/surface"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <!-- Hamburger Menu Button ≡ -->
            <FrameLayout
                android:id="@+id/btnMenu"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_lucide_menu"
                    app:tint="@color/text_primary" />
            </FrameLayout>

            <!-- User Name and Role -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTopUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="মেস মেম্বার"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTopUserRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Member"
                    android:textColor="@color/coral_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Meal ON/OFF Toggle Switch in Navbar -->
            <LinearLayout
                android:id="@+id/layoutMealToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_white_rounded_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp"
                android:paddingVertical="1dp">

                <TextView
                    android:id="@+id/tvMealToggleLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="মিল"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchQuickDinner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleX="0.75"
                    android:scaleY="0.75"
                    app:useMaterialThemeColors="true" />
            </LinearLayout>

            <!-- Cloud Sync Button in Navbar (Enabled for any user in paid mess account) -->
            <FrameLayout
                android:id="@+id/btnCloudSyncContainer"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_stepper_circle"
                android:backgroundTint="#F1F5F9">

                <ImageButton
                    android:id="@+id/btnCloudSync"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Cloud Sync"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_lucide_refresh"
                    app:tint="@color/primary" />
            </FrameLayout>

            <!-- Notification Bell Icon Button with Badge in Navbar (Replaces message icon) -->
            <FrameLayout
                android:id="@+id/btnNotificationCenter"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_stepper_circle"
                android:backgroundTint="#F1F5F9"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivNotificationIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_lucide_bell"
                    app:tint="@color/text_primary" />

                <TextView
                    android:id="@+id/tvNotificationBadge"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/badge_due"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@android:color/white"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Profile Avatar Button -->
            <FrameLayout
                android:id="@+id/btnOpenProfileDrawer"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_circle_avatar"
                android:backgroundTint="#FEE2E2"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivAvatarMockup"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_avatar_cartoon" />

                <TextView
                    android:id="@+id/tvAvatarInitials"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="মে"
                    android:textColor="@color/coral_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Backwards-compatibility stubs retained with GONE visibility -->
            <TextView android:id="@+id/tvTopMessName" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/tvTopPlanPill" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/chipBalanceBadge" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

        </LinearLayout>

        <!-- FRAGMENT HOSTING VIEW (High Density Screen Utilization) -->
        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 5-TAB COMPACT BOTTOM NAVIGATION BAR: Home | Bazar | Meals | SMS | All Members -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/surface"
            app:elevation="8dp"
            app:itemIconTint="@color/selector_nav_tint"
            app:itemTextColor="@color/selector_nav_tint"
            app:itemIconSize="20dp"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/menu_bottom_nav" />

    </LinearLayout>

    <!-- RIGHT-SIDE SLIDE-OVER PROFILE DRAWER -->
    <include
        layout="@layout/layout_drawer_right_hub"
        android:layout_width="310dp"
        android:layout_height="match_parent"
        android:layout_gravity="end" />

</androidx.drawerlayout.widget.DrawerLayout>
