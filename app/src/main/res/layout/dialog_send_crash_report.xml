<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_dialog_rounded">

    <!-- Header Icon and Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_lucide_shield_alert"
            app:tint="@color/error_red"
            android:layout_marginEnd="12dp"
            android:contentDescription="Crash Alert" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="অ্যাপ ক্র্যাশ রিপোর্ট শনাক্ত হয়েছে"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="স্বয়ংক্রিয় এরর ও ক্র্যাশ ডায়াগনস্টিক"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SmartMess অপ্রত্যাশিতভাবে বন্ধ হয়ে গিয়েছিল। ক্র্যাশ সংক্রান্ত ত্রুটির বিবরণ এবং সিস্টেম লগ প্রস্তুত করা হয়েছে। দ্রুত সমাধানের জন্য ডেভেলপার টিমের কাছে রিপোর্ট পাঠাতে পারেন।"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:lineSpacingExtra="3dp"
        android:layout_marginBottom="12dp" />

    <!-- Error Title Summary Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_stat_card"
        android:padding="10dp"
        android:layout_marginBottom="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="শনাক্তকৃত ত্রুটি:"
            android:textColor="@color/error_red"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDialogErrorSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="NullPointerException in main thread"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Optional User Note Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="আপনার মন্তব্য বা বিবরণ (ঐচ্ছিক):"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etDialogUserNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_edittext"
        android:hint="ক্র্যাশ হওয়ার সময় কী করছিলেন? (যেমন: মিল বা খরচ যোগ করার সময়...)"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="13sp"
        android:minLines="2"
        android:maxLines="4"
        android:gravity="top|start"
        android:padding="10dp"
        android:inputType="textMultiLine|textCapSentences"
        android:layout_marginBottom="16dp" />

    <!-- Progress Indicator -->
    <ProgressBar
        android:id="@+id/dialogProgressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        android:layout_marginBottom="12dp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogSendReport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="সার্ভারে রিপোর্ট পাঠান"
            style="@style/SmartButton"
            android:backgroundTint="@color/primary"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDialogViewDetails"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="লগ বিস্তারিত দেখুন"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDialogRestartApp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="রিস্টার্ট করুন"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:textColor="@color/text_secondary" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
