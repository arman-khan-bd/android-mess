<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeColor="#F1F5F9"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Row: Member name, Date, Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_circle_avatar"
                android:backgroundTint="#FEE2E2"
                android:padding="7dp"
                android:src="@drawable/ic_meal"
                app:tint="@color/coral_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvReqMemberName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="মেম্বার নাম"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvReqDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="তারিখ: 10 Oct 2026"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvReqStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_selected"
                android:backgroundTint="@color/warning_amber_bg"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="অপেক্ষমাণ"
                android:textColor="@color/warning_amber"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Meal breakdown chips / counts -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#F8FAFC"
            android:padding="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvReqBreakfast"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="সকাল: 0"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <View
                android:layout_width="1dp"
                android:layout_height="14dp"
                android:background="#CBD5E1" />

            <TextView
                android:id="@+id/tvReqLunch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="দুপুর: 1"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <View
                android:layout_width="1dp"
                android:layout_height="14dp"
                android:background="#CBD5E1" />

            <TextView
                android:id="@+id/tvReqDinner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="রাত: 1"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <View
                android:layout_width="1dp"
                android:layout_height="14dp"
                android:background="#CBD5E1" />

            <TextView
                android:id="@+id/tvReqGuest"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="অতিথি: 0"
                android:textColor="@color/coral_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Optional Note -->
        <TextView
            android:id="@+id/tvReqNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="নোট: ২ জন অতিথি আসবে"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Manager Actions (visible for manager when pending) -->
        <LinearLayout
            android:id="@+id/layoutManagerActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRejectReq"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:text="বাতিল"
                android:textColor="@color/error_red"
                android:textSize="12sp"
                app:backgroundTint="#FEE2E2"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApproveReq"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="অনুমোদন করুন"
                android:textColor="@color/surface"
                android:textSize="12sp"
                app:backgroundTint="@color/credit_green"
                app:cornerRadius="8dp" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
