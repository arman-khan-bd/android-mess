<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <!-- Member Selector Spinner -->
    <Spinner
        android:id="@+id/spPayerMember"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1.4"
        android:background="@drawable/rounded_edittext" />

    <!-- Amount Paid EditText -->
    <EditText
        android:id="@+id/etPayerAmount"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:background="@drawable/rounded_edittext"
        android:hint="৳ 0.00"
        android:inputType="numberDecimal"
        android:paddingHorizontal="12dp"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Delete Payer Button -->
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnDeletePayerRow"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Remove Contributor"
        android:padding="12dp"
        app:srcCompat="@drawable/ic_lucide_trash" />

</LinearLayout>
