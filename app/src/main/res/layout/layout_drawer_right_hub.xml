<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutRightDrawerHub"
    android:layout_width="310dp"
    android:layout_height="match_parent"
    android:layout_gravity="end"
    android:background="@color/surface"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <!-- Drawer Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_variant"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Profile Avatar with Circular Crop / Initials -->
            <FrameLayout
                android:id="@+id/drawerAvatarContainer"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_alignParentStart="true"
                android:background="@drawable/bg_circle_avatar">

                <TextView
                    android:id="@+id/tvDrawerAvatarInitials"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="AK"
                    android:textColor="@android:color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Edit Photo Action -->
            <ImageButton
                android:id="@+id/btnDrawerEditPhoto"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Edit Photo"
                android:src="@drawable/ic_camera"
                app:tint="@color/text_secondary" />
        </RelativeLayout>

        <!-- User Full Name (Decrypted display) -->
        <TextView
            android:id="@+id/tvDrawerUserName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Arman Khan"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Phone / Email display -->
        <TextView
            android:id="@+id/tvDrawerUserPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="+8801700000000"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Role Badge + Plan Tier Pill -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDrawerRoleBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_credit"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="Manager"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDrawerPlanPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/badge_credit"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="Pro Plan"
                android:textColor="@color/primary_dark"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_stroke" />

    <!-- Drawer Scrollable Menu Items -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="8dp"
            android:paddingHorizontal="8dp">

            <!-- 1. My Profile & Account -->
            <LinearLayout
                android:id="@+id/drawerItemProfile"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_drawer_item_selectable"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_lucide_user_cog"
                    app:tint="@color/text_primary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="My Profile &amp; Account"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 2. Subscription & Plans -->
            <LinearLayout
                android:id="@+id/drawerItemPlans"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_drawer_item_selectable"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_lucide_crown"
                    app:tint="@color/warning_amber" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="Subscription &amp; Plans"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvDrawerUpgradeTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_credit"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="PRO"
                    android:textColor="@color/primary"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 3. SMS Dispatcher & Rates -->
            <LinearLayout
                android:id="@+id/drawerItemSms"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_drawer_item_selectable"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_lucide_message_square"
                    app:tint="@color/text_primary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="SMS Dispatcher &amp; Rates"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 4. Invoice & Statement Generator -->
            <LinearLayout
                android:id="@+id/drawerItemStatements"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_drawer_item_selectable"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_lucide_file_text"
                    app:tint="@color/text_primary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="Invoice &amp; Statements"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 5. Meal Vacation Mode -->
            <LinearLayout
                android:id="@+id/drawerItemVacation"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_drawer_item_selectable"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_vacation"
                    app:tint="@color/text_primary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="Meal Vacation Mode"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_credit"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="Auto-Off"
                    android:textColor="@color/primary"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 6. In-App Notification Center -->
            <LinearLayout
                android:id="@+id/drawerItemNotifications"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_drawer_item_selectable"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_lucide_bell"
                    app:tint="@color/text_primary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="Notification Center"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 7. Support Tickets & Helpdesk -->
            <LinearLayout
                android:id="@+id/drawerItemSupport"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_drawer_item_selectable"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_lucide_life_buoy"
                    app:tint="@color/text_primary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="Support Tickets &amp; Helpdesk"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 6. Report Bug / Suggestion -->
            <LinearLayout
                android:id="@+id/drawerItemBugReport"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_drawer_item_selectable"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_lucide_alert_circle"
                    app:tint="@color/text_primary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="Report Bug / Suggestion"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="6dp"
                android:background="@color/border_stroke" />

            <!-- Manager Section Header -->
            <TextView
                android:id="@+id/tvDrawerManagerHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="MANAGER CONTROLS"
                android:textColor="@color/text_muted"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- 7. Mess Settings & Cut-off (Manager Only) -->
            <LinearLayout
                android:id="@+id/drawerItemSettings"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_drawer_item_selectable"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_lucide_sliders"
                    app:tint="@color/text_primary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="Mess Settings &amp; Cut-off"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Notification Dispatcher (Manager Only) -->
            <LinearLayout
                android:id="@+id/drawerItemNotifManager"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_drawer_item_selectable"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_lucide_bell"
                    app:tint="@color/primary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="Notification Dispatcher"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_credit"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="Push+SMS"
                    android:textColor="@color/primary_dark"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 8. Handover Manager Role (Manager Only) -->
            <LinearLayout
                android:id="@+id/drawerItemHandover"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_drawer_item_selectable"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_lucide_shield_alert"
                    app:tint="@color/due_red" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="Handover Manager Role"
                    android:textColor="@color/due_red"
                    android:textSize="13sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="6dp"
                android:background="@color/border_stroke" />

            <!-- 9. Sign Out -->
            <LinearLayout
                android:id="@+id/drawerItemSignOut"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_drawer_item_selectable"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_lucide_logout"
                    app:tint="@color/due_red" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="Sign Out"
                    android:textColor="@color/due_red"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Version & Build Footer -->
    <TextView
        android:id="@+id/tvDrawerAppVersion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="12dp"
        android:text="SmartMess v2.4.0 • Offline Ready"
        android:textColor="@color/text_muted"
        android:textSize="11sp" />

</LinearLayout>
