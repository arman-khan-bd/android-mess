<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:padding="20dp">

    <!-- TOP HEADER: CATEGORY PILL + CHANNEL PILL + CLOSE BUTTON -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Category Pill Badge -->
        <TextView
            android:id="@+id/tvFullNotifCategoryBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_credit"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="📢 NOTICE"
            android:textColor="@color/primary_dark"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Channel Badge -->
        <TextView
            android:id="@+id/tvFullNotifChannelBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/badge_due"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="🔔 PUSH"
            android:textColor="@color/due_red"
            android:textSize="10sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnFullNotifClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            android:src="@drawable/ic_close"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- NOTIFICATION TITLE -->
    <TextView
        android:id="@+id/tvFullNotifTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="sans-serif-medium"
        android:text="Urgent Mess Announcement"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- TIMESTAMP & DELIVERY META -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_clock"
            app:tint="@color/text_secondary" />

        <TextView
            android:id="@+id/tvFullNotifTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="sans-serif"
            android:text="Today at 08:30 PM • Stored in SQLite"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="14dp"
        android:background="@color/divider" />

    <!-- FULL MESSAGE BODY (SCROLLABLE & SELECTABLE) -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="260dp">

        <TextView
            android:id="@+id/tvFullNotifMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="4dp"
            android:text="Full notification message text goes here. Users can read the entire announcement without truncation."
            android:textColor="@color/text_primary"
            android:textIsSelectable="true"
            android:textSize="14sp" />
    </androidx.core.widget.NestedScrollView>

    <!-- DELIVERY DISPATCH SUMMARY CARD -->
    <LinearLayout
        android:id="@+id/layoutDeliveryMetaCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_stat_card"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvFullNotifSenderMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Dispatched by Mess Management"
            android:textColor="@color/primary_dark"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFullNotifChannelDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:text="Delivered via Online Push Notification &amp; Device System Tray"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- ACTION BUTTONS ROW -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="end"
        android:orientation="horizontal">

        <!-- Copy Text Action -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFullNotifCopy"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="sans-serif-medium"
            android:text="Copy"
            android:textSize="12sp"
            app:cornerRadius="10dp"
            app:icon="@drawable/ic_copy"
            app:iconSize="14dp" />

        <!-- Contextual Action: Pay Due (shown for due reminders) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFullNotifPayDue"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/credit_green"
            android:fontFamily="sans-serif-medium"
            android:text="Deposit"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:visibility="gone"
            app:cornerRadius="10dp"
            app:icon="@drawable/ic_deposit"
            app:iconSize="14dp" />

        <!-- Dismiss / OK Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFullNotifDismiss"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:backgroundTint="@color/primary"
            android:fontFamily="sans-serif-medium"
            android:text="Done"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            app:cornerRadius="10dp" />
    </LinearLayout>

</LinearLayout>
