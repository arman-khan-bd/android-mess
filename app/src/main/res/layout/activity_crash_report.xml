<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Top AppBar Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarCrashReport"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        android:elevation="2dp"
        app:navigationIcon="@drawable/ic_close"
        app:navigationIconTint="@color/text_primary"
        app:title="ক্র্যাশ ও এরর ডায়াগনস্টিক"
        app:titleTextColor="@color/text_primary"
        app:titleTextAppearance="@style/TextAppearance.MaterialComponents.Headline6" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero Alert Banner -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface"
                app:strokeColor="@color/error_red"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_lucide_shield_alert"
                            app:tint="@color/error_red"
                            android:layout_marginEnd="12dp"
                            android:contentDescription="Alert Icon" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="অ্যাপ ক্র্যাশ স্বয়ংক্রিয় শনাক্ত হয়েছে"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvCrashTimestamp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="আজকের লাইভ সেশন"
                                android:textColor="@color/text_muted"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvReportStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/badge_due"
                            android:text="পেন্ডিং"
                            android:textColor="@color/error_red"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="SmartMess ব্যবহারের সময় একটি অনাকাঙ্ক্ষিত ত্রুটি ঘটেছে। এই ত্রুটির সম্পূর্ণ ডায়াগনস্টিক ডেটা ডিভাইসে সংরক্ষিত আছে এবং সরাসরি সার্ভারে পাঠানো সম্ভব।"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp" />

                    <!-- Error Class & Message Box -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_stat_card"
                        android:padding="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="শনাক্তকৃত ত্রুটির শিরোনাম:"
                            android:textColor="@color/error_red"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCrashTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="NullPointerException: Attempt to invoke virtual method..."
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:fontFamily="monospace"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCrashThread"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Thread: main"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Device Diagnostics Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                style="@style/SmartCardView">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ডিভাইস ও সিস্টেম ডায়াগনস্টিক"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:id="@+id/tvDeviceSpecs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="4dp"
                        android:text="মডেল: লোড হচ্ছে...\nঅ্যান্ড্রয়েড ভার্সন: লোড হচ্ছে...\nর‍্যাম: লোড হচ্ছে...\nস্টোরেজ: লোড হচ্ছে..."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Optional User Note Input Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                style="@style/SmartCardView">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="আপনার মন্তব্য বা ঐচ্ছিক বিবরণ"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="10dp"
                        android:text="ক্র্যাশ হওয়ার সময় আপনি কী কাজ করছিলেন লিখলে ডেভেলপারদের দ্রুত সমাধান করতে সাহায্য করবে।"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/etUserNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/rounded_edittext"
                        android:hint="যেমন: দৈনিক মিল ইনপুট দেওয়ার সময়, রসিদ ছবি তোলার সময় বা ব্যালেন্স দেখার সময় ক্র্যাশ করেছে..."
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="13sp"
                        android:minLines="3"
                        android:maxLines="6"
                        android:gravity="top|start"
                        android:padding="12dp"
                        android:inputType="textMultiLine|textCapSentences" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Stack Trace Details Collapsible Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                style="@style/SmartCardView">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="কারিগরি লগ ও স্ট্যাক ট্রেস"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCopyStackTrace"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="কপি"
                            android:textSize="12sp"
                            app:icon="@drawable/ic_copy"
                            app:iconSize="14dp"
                            style="@style/Widget.MaterialComponents.Button.TextButton" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnToggleStackTrace"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="প্রদর্শন"
                            android:textSize="12sp"
                            style="@style/Widget.MaterialComponents.Button.TextButton" />
                    </LinearLayout>

                    <HorizontalScrollView
                        android:id="@+id/layoutStackTrace"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_stat_card"
                        android:padding="10dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvStackTrace"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"
                            android:text="লগ ডেটা নেই" />
                    </HorizontalScrollView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Loading Indicator -->
            <ProgressBar
                android:id="@+id/progressBarReport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="16dp" />

            <!-- Action Buttons at bottom -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSendReport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="সার্ভারে ক্র্যাশ রিপোর্ট পাঠান"
                style="@style/SmartButton"
                android:backgroundTint="@color/primary"
                android:layout_marginBottom="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRestartApp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="স্মার্টমেস অ্যাপ পুনরায় চালু করুন"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCloseApp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="অ্যাপ বন্ধ করুন"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:textColor="@color/text_muted" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
