<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme: Compact Material 3 -->
    <style name="Theme.SmartMess" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent</item>
        <item name="colorOnSecondary">@color/text_on_primary</item>
        
        <!-- Status bar styling -->
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowBackground">@color/background</item>
        
        <!-- Global Sans-Serif Typography Enforcement (overrides phone handwriting/cursive fonts) -->
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textViewStyle">@style/SmartTextView</item>
        <item name="android:editTextStyle">@style/SmartEditText</item>
        <item name="android:buttonStyle">@style/SmartButton</item>
        <item name="materialButtonStyle">@style/SmartButton</item>
        <item name="cardViewStyle">@style/SmartCardView</item>
        <item name="materialCardViewStyle">@style/SmartCardView</item>
        <item name="chipStyle">@style/SmartChip</item>
    </style>

    <style name="Theme.SmartMess.NoActionBar" parent="Theme.SmartMess" />

    <style name="SmartTextView" parent="android:Widget.TextView">
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="SmartEditText" parent="android:Widget.EditText">
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_muted</item>
    </style>

    <style name="SmartCardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">10dp</item>
        <item name="cardElevation">1dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/border_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="SmartButton" parent="Widget.MaterialComponents.Button">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SmartChip" parent="Widget.MaterialComponents.Chip.Action">
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="chipCornerRadius">6dp</item>
        <item name="chipMinHeight">28dp</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>
