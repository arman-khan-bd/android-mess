<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".SmartMessApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_meal"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_meal"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartMess"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="34">

        <!-- Splash Activity (Launcher) -->
        <activity
            android:name=".ui.auth.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.SmartMess.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Auth Activities -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Main App Core Navigation -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="false" />

        <!-- Dashboard Activity -->
        <activity
            android:name=".ui.dashboard.DashboardActivity"
            android:exported="false" />

        <!-- Expenses -->
        <activity
            android:name=".ui.expenses.ActivityAddExpense"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.expenses.ActivityAddBazar"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Meals -->
        <activity
            android:name=".ui.meals.MealListActivity"
            android:exported="false" />
        <activity
            android:name=".ui.meals.AddMealActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.meals.DailyMealToggleActivity"
            android:exported="false" />

        <!-- Expenses -->
        <activity
            android:name=".ui.expenses.ExpenseListActivity"
            android:exported="false" />
        <activity
            android:name=".ui.expenses.AddExpenseActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Deposits -->
        <activity
            android:name=".ui.deposits.DepositListActivity"
            android:exported="false" />
        <activity
            android:name=".ui.deposits.AddDepositActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Members -->
        <activity
            android:name=".ui.members.MemberListActivity"
            android:exported="false" />
        <activity
            android:name=".ui.members.AddMemberActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.members.ActivityUserProfile"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.members.ActivityMemberManage"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.members.ActivityMessInvite"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="mess.e-bd.shop"
                    android:pathPrefix="/join" />
            </intent-filter>
        </activity>

        <!-- SMS Management & Costing -->
        <activity
            android:name=".ui.sms.ActivitySmsDispatch"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.sms.SmsBroadcastActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.sms.DueReminderActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Financial Reports & Settlement -->
        <activity
            android:name=".ui.reports.SummaryReportActivity"
            android:exported="false" />

        <!-- Mess Settings & Subscription -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false" />

        <!-- Telemetry & Feedback Reporting -->
        <activity
            android:name=".ui.telemetry.ActivityReportIssue"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Two-Way Support Desk -->
        <activity
            android:name=".ui.support.ActivitySupportTickets"
            android:exported="false" />
        <activity
            android:name=".ui.support.ActivityTicketChat"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Network Change Receiver for Auto Sync on Reconnection -->
        <receiver
            android:name=".data.sync.NetworkChangeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.net.conn.CONNECTIVITY_CHANGE" />
            </intent-filter>
        </receiver>

        <!-- Daily 22:00 Cut-Off Meal Reminder Receiver -->
        <receiver
            android:name=".notification.DailyReminderReceiver"
            android:exported="false" />

        <!-- Reboot Alarm Restorer Receiver -->
        <receiver
            android:name=".notification.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Bazar Ledger & Interactive Data Table -->
        <activity
            android:name=".ui.expenses.ActivityBazarLedger"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Secure File Provider for PDF & Excel Exporters -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
